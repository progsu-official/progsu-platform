# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose these in a NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Resend (Task 8)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mail.progsu.com
RESEND_WEBHOOK_SECRET=

# OTP tunables (Task 8)
OTP_CODE_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_BCRYPT_COST=12

# Events platform feature flags (Release 1+)
FEATURE_EVENTS=false
FEATURE_MEMBER_DIRECTORY=false
FEATURE_SHARED_EVENT_HISTORY=false

# Public member-profile sections (/members/[slug]). Not per-member consent,
# there isn't one for these two yet — just a global on/off.
FEATURE_PUBLIC_PROFILE_RESUME=false
# FEATURE_PUBLIC_PROFILE_EVENTS=true (unset = on)
FEATURE_REFERRAL_LINKS=false

# Discord RSVP announcements (docs/18-discord-rsvp-alerts.md). Posts a member's
# first name + last initial into a channel the whole server reads, so this must
# stay false until the privacy_policy v7 cascade has run. Unset webhook URL is
# also a no-op, so the flag and the URL both have to be present to post.
FEATURE_DISCORD_RSVP_ALERTS=false
DISCORD_RSVP_WEBHOOK_URL=

# Daily recap (same doc). Separate flag: the recap counts RSVPs and never names
# one, so it is not a peer-visible surface and does not wait on the v7 cascade.
# Falls back to DISCORD_RSVP_WEBHOOK_URL when no recap-specific URL is set.
FEATURE_DISCORD_RECAP=false
DISCORD_RECAP_WEBHOOK_URL=
# Optional role to ping on the recap only, as a bare snowflake id.
DISCORD_RECAP_ROLE_ID=

# SMS broadcasts (/admin/sms, docs/19-sms-broadcasts.md). The flag hides the
# page and stops the delivery worker; the STOP webhook runs regardless.
FEATURE_SMS=false
# 30-minute event reminders ride on FEATURE_SMS. Unset = on; set false to stop
# reminders alone. Per-event switch is in each event's options.
# FEATURE_SMS_EVENT_REMINDERS=true
# Account SID (AC...) goes in the request path; sending authenticates with an
# API key (SK...) and its secret, and always through the Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
# Only used to verify X-Twilio-Signature on the inbound/status webhooks, which
# an API key secret cannot do. Unset: both webhooks answer 401 and texts never
# move past "sent".
TWILIO_AUTH_TOKEN=

# Cron worker auth (required only when running the reminder/cancellation worker)
CRON_SECRET=

# Shared bearer for POST /api/team-finder-lookup, the server-to-server member
# lookup hacklanta-ii calls. Same constant-time compare as the cron routes, and
# the same value has to be set on the calling side. Unset fails the compare, so
# the endpoint answers 401 rather than erroring — a missing key here looks
# exactly like a bad key from the caller.
TEAM_FINDER_SYNC_SECRET=

# WalletWallet (walletwallet.dev) — Apple/Google Wallet pass API for the
# personal check-in QR's "Add to Wallet" button.
WALLETWALLET_API_KEY=

# Google OAuth (primary sign-in, supabase/config.toml [auth.external.google]).
# That provider block is enabled, so `supabase start` needs both of these or
# every /login attempt fails at the provider.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Discord OAuth (identity linking for member cards, supabase/config.toml [auth.external.discord])
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# Service-account JSON for scripts/import-historical-events.ts only. Defaults to
# .secrets/progsu-agent-drive.json when unset; not needed to run the app.
# GOOGLE_DRIVE_CREDENTIALS=.secrets/progsu-agent-drive.json

# Local dev convenience: set true to auto-sign-in as dev-member instead of
# hitting /login. Never active outside NODE_ENV=development regardless of
# this value. Off by default — opt in per machine.
DEV_AUTO_LOGIN=false

# Local dev convenience: set true to click through onboarding quickly. Forms
# are pre-filled with dummy values, no OTP email is sent, and the verification
# code is always 000000. Visit /api/dev-login?role=onboarding for a fresh
# not-yet-onboarded test account. Never active outside NODE_ENV=development.
ONBOARDING_TEST_MODE=false

# Native iOS app API (/api/mobile/v1, docs/ios/API.md). Route-edge kill switch.
FEATURE_MOBILE_API=false
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Apple
# refresh tokens (AES-256-GCM). Unset: /me/apple-authorization answers 503.
APP_ENCRYPTION_KEY=
# Sign in with Apple token exchange + revocation on account deletion.
# APPLE_SERVICES_ID is the client_id: the app bundle id for native sign-in.
# APPLE_PRIVATE_KEY is the .p8 contents (\n-escaped is fine).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SERVICES_ID=
# APNs token auth. Any missing: the push worker marks rows skipped and sends nothing.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
# Apple Wallet pass signing (PEM, \n-escaped is fine). Any missing: the
# wallet route answers 503 unavailable.
PASS_TYPE_ID=
PASS_TEAM_ID=
PASS_SIGNER_CERT=
PASS_SIGNER_KEY=
PASS_SIGNER_KEY_PASSPHRASE=
PASS_WWDR_CERT=
# Hacklanta II project (already used by /admin/sms; also used by the mobile
# Hacklanta link + status routes).
HACKLANTA_SUPABASE_URL=
HACKLANTA_SUPABASE_SECRET_KEY=
